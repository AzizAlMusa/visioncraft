# visualization/panels/vector_field_panel.py
import numpy as np
from .base_panel import ViewerPanel

class VectorFieldPanel(ViewerPanel):
    """Right panel: Vector fields (attr, rep, total) with viewpoint overlay."""
    def __init__(self, grid_size):
        super().__init__(title="Vector Field")
        self.grid_size = grid_size
        self.mode = "total"
        

    # ---------------------------------------------------------
    def init(self, ax):
        super().init(ax)

        self.i_selected = 0  # track highlighted viewpoint
        self.arrow_attr = None
        self.arrow_rep = None
        self.arrow_total = None

        self.ax.set_facecolor("#111111")
        self.ax.set_xlim(0, self.grid_size)
        self.ax.set_ylim(0, self.grid_size)
        self.ax.set_aspect("equal", "box")

        stride = max(1, self.grid_size // 20)
        Xs = np.arange(0, self.grid_size, stride)
        Ys = np.arange(0, self.grid_size, stride)
        Xg, Yg = np.meshgrid(Xs, Ys)
        self._stride, self._Xg, self._Yg = stride, Xg, Yg

        Z = np.zeros_like(Xg)
        self.quiv_attr = self.ax.quiver(Xg, Yg, Z, Z, color="#00E0FF", scale=60)
        self.quiv_rep  = self.ax.quiver(Xg, Yg, Z, Z, color="#FF00C8", scale=60)
        self.quiv_tot  = self.ax.quiver(Xg, Yg, Z, Z, color="#00FFAA", scale=60)

        # === viewpoint overlays (restored from ViewerDual) ===
        self.scat_right = self.ax.scatter([], [], s=60, c="#FFD166",
                                          edgecolors="black", linewidths=0.8, zorder=4)
        self.highlight = self.ax.scatter([], [], s=90, c="#FF5500",
                                         marker="*", edgecolors="white",
                                         linewidths=1.2, zorder=5)

        self._set_visibility()


    def _update_force_arrows(self, active_pos, F_attr, F_rep, F_total, scale=2.0):
        # Remove old arrows if exist
        for arr in [self.arrow_attr, self.arrow_rep, self.arrow_total]:
            if arr is not None:
                arr.remove()

        # Draw new arrows
        if active_pos is None:
            return

        x, y = active_pos
        self.arrow_attr = self.ax.arrow(
            x, y, F_attr[0]*scale, F_attr[1]*scale,
            color="#00E0FF", width=0.5, head_width=2.0, zorder=6, alpha=0.8
        )
        self.arrow_rep = self.ax.arrow(
            x, y, F_rep[0]*scale, F_rep[1]*scale,
            color="#FF00C8", width=0.5, head_width=2.0, zorder=6, alpha=0.8
        )
        
        self.arrow_total = self.ax.arrow(
            x, y, F_total[0]*scale, F_total[1]*scale,
            color="#00FFAA", width=0.5, head_width=2.0, zorder=6, alpha=0.9
        )



    # ---------------------------------------------------------
    def _set_visibility(self):
        self.quiv_attr.set_visible(self.mode in ["attr", "both"])
        self.quiv_rep.set_visible(self.mode in ["rep", "both"])
        self.quiv_tot.set_visible(self.mode == "total")

    # ---------------------------------------------------------
    def handle_key(self, key):
        # same keyboard shortcuts as before
        modes = {"a": "attr", "r": "rep", "t": "total", "b": "both"}
        if key in modes:
            self.mode = modes[key]
            print(f"[VectorFieldPanel] Mode={self.mode}")
            self._set_visibility()
        elif key == "n":
            self.i_selected += 1
            print(f"[VectorFieldPanel] Cycle viewpoint highlight -> {self.i_selected}")

    # ---------------------------------------------------------
    def update(self, data):
        stride = self._stride
        Fx_attr, Fy_attr = data.get("Fx_attr"), data.get("Fy_attr")
        Fx_rep, Fy_rep = data.get("Fx_rep"), data.get("Fy_rep")
        Fx_total, Fy_total = data.get("Fx_total"), data.get("Fy_total")
        particles = data.get("particles", [])

        # update quivers
        if Fx_attr is not None:
            self.quiv_attr.set_UVC(Fx_attr[::stride, ::stride],
                                   Fy_attr[::stride, ::stride])
        if Fx_rep is not None:
            self.quiv_rep.set_UVC(Fx_rep[::stride, ::stride],
                                  Fy_rep[::stride, ::stride])
        if Fx_total is not None:
            self.quiv_tot.set_UVC(Fx_total[::stride, ::stride],
                                  Fy_total[::stride, ::stride])

        # === overlay viewpoints (restored) ===
        if len(particles) > 0:
            self.scat_right.set_offsets(particles)
            # wrap highlight index
            self.i_selected %= len(particles)
            self.highlight.set_offsets([particles[self.i_selected]])
        else:
            self.scat_right.set_offsets([])
            self.highlight.set_offsets([])

        self._set_visibility()

        # --- draw force arrows for active viewpoint ---
        i_active = data.get("active_index", 0)
        F_attr = data.get("F_attr")
        F_rep = data.get("F_rep")
        F_total = data.get("F_total")
        particles = data.get("particles", [])

        if (F_attr is not None) and (len(particles) > 0):
            p = particles[i_active]
            k_rep = data.get("k_rep", 1.0)  # pass it from main
            self._update_force_arrows(
                p,
                F_attr[i_active],
                k_rep * F_rep[i_active],     # scale to match simulation
                F_total[i_active]
            )


